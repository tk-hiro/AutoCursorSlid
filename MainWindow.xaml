<Window x:Class="DishAuto.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:DishAuto.Core"
        Title="皿洗いオート" Width="470" SizeToContent="Height"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        FontFamily="Yu Gothic UI" FontSize="13">
    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Width" Value="64" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinWidth" Value="240" />
            <Setter Property="DisplayMemberPath" Value="Label" />
            <Setter Property="SelectedValuePath" Value="Value" />
        </Style>
        <Style TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <!-- 操作ボタンと状態 -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Vertical" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Height="36" Click="Start_Click" IsEnabled="{Binding IsIdle}"
                        Content="開始 (F9)" FontWeight="Bold" />
                <Button Grid.Column="2" Height="36" Click="Stop_Click" IsEnabled="{Binding IsRunning}"
                        Content="停止 (F10 / Esc)" />
            </Grid>
            <Border Margin="0,10,0,0" Padding="8,6" Background="#FFF3F3F3" CornerRadius="4">
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <!-- 設定 -->
        <Grid IsEnabled="{Binding IsIdle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource Label}" Text="範囲" />
            <StackPanel Grid.Row="0" Grid.Column="1">
                <TextBlock Text="{Binding RegionText}" VerticalAlignment="Center" MinWidth="200" />
                <Button Content="範囲を選択…" Padding="10,2" Click="SelectRegion_Click" />
            </StackPanel>

            <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="形状" />
            <StackPanel Grid.Row="1" Grid.Column="1">
                <ComboBox ItemsSource="{x:Static core:Options.Shapes}" SelectedValue="{Binding Settings.Shape}" />
            </StackPanel>

            <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="パターン" />
            <StackPanel Grid.Row="2" Grid.Column="1">
                <ComboBox ItemsSource="{x:Static core:Options.Patterns}" SelectedValue="{Binding Settings.Pattern}" />
            </StackPanel>

            <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="移動速度" />
            <StackPanel Grid.Row="3" Grid.Column="1">
                <Slider Width="160" Minimum="100" Maximum="5000" SmallChange="50" LargeChange="500"
                        VerticalAlignment="Center" Margin="0,0,8,0"
                        Value="{Binding Settings.SpeedPxPerSec}" />
                <TextBox Text="{Binding Settings.SpeedPxPerSec, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="px/秒" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="線の間隔" />
            <StackPanel Grid.Row="4" Grid.Column="1">
                <TextBox Text="{Binding Settings.Spacing, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="px（小さいほど細かく擦る）" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Grid.Row="5" Style="{StaticResource Label}" Text="移動方式" />
            <StackPanel Grid.Row="5" Grid.Column="1">
                <ComboBox ItemsSource="{x:Static core:Options.MoveModes}" SelectedValue="{Binding Settings.MoveMode}" />
            </StackPanel>

            <TextBlock Grid.Row="6" Style="{StaticResource Label}" Text="洗剤" />
            <StackPanel Grid.Row="6" Grid.Column="1">
                <CheckBox Content="スペースを押す" IsChecked="{Binding Settings.DetergentEnabled}" />
                <TextBox Text="{Binding Settings.DetergentIntervalSec, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding Settings.DetergentEnabled}" />
                <TextBlock Text="秒ごと" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Grid.Row="7" Style="{StaticResource Label}" Text="クリック" />
            <StackPanel Grid.Row="7" Grid.Column="1">
                <CheckBox Content="左クリックを押したまま動かす" IsChecked="{Binding Settings.HoldLeftButton}" />
            </StackPanel>

            <TextBlock Grid.Row="8" Style="{StaticResource Label}" Text="押し直し" />
            <StackPanel Grid.Row="8" Grid.Column="1" IsEnabled="{Binding Settings.HoldLeftButton}">
                <TextBox Text="{Binding Settings.RepressIntervalSec, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="秒ごとに左ボタンを押し直す（0 = しない）" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Grid.Row="9" Style="{StaticResource Label}" Text="制限時間" />
            <StackPanel Grid.Row="9" Grid.Column="1">
                <TextBox Text="{Binding Settings.TimeLimitSec, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="秒（0 = 無制限）" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Grid.Row="10" Style="{StaticResource Label}" Text="開始待ち" />
            <StackPanel Grid.Row="10" Grid.Column="1">
                <TextBox Text="{Binding Settings.CountdownSec, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="秒（この間にゲーム画面を前面に）" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Grid.Row="11" Style="{StaticResource Label}" Text="安全" VerticalAlignment="Top" Margin="0,6,12,0" />
            <StackPanel Grid.Row="11" Grid.Column="1" Orientation="Vertical">
                <CheckBox Margin="0,2" Content="マウスを手で動かしたら停止" IsChecked="{Binding Settings.StopOnUserMouse}" />
                <CheckBox Margin="0,2" Content="前面のウィンドウが変わったら停止" IsChecked="{Binding Settings.StopOnFocusChange}" />
                <CheckBox Margin="0,2" Content="実行中はこのウィンドウを最小化" IsChecked="{Binding Settings.MinimizeWhileRunning}" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
