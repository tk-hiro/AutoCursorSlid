<Window x:Class="DishAuto.Views.RegionSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="範囲を選択" WindowStyle="None" AllowsTransparency="True" Background="#66000000"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" Cursor="Cross"
        FontFamily="Yu Gothic UI" KeyDown="Window_KeyDown">
    <Canvas x:Name="Root" Background="Transparent"
            MouseLeftButtonDown="Root_MouseLeftButtonDown"
            MouseMove="Root_MouseMove"
            MouseLeftButtonUp="Root_MouseLeftButtonUp"
            MouseRightButtonUp="Root_MouseRightButtonUp">
        <!-- 現在設定されている範囲 -->
        <Rectangle x:Name="Previous" Stroke="Gold" StrokeThickness="2" StrokeDashArray="4 3"
                   Visibility="Collapsed" IsHitTestVisible="False" />
        <!-- ドラッグ中の範囲 -->
        <Rectangle x:Name="Selection" Stroke="#FF33AAFF" StrokeThickness="2" Fill="#4033AAFF"
                   Visibility="Collapsed" IsHitTestVisible="False" />
        <Border x:Name="Hint" Background="#E0202020" CornerRadius="6" Padding="14,10" IsHitTestVisible="False">
            <TextBlock x:Name="HintText" Foreground="White" FontSize="15" LineHeight="24">
                ドラッグで擦る範囲を囲んでください（点線は現在の範囲）<LineBreak />
                Esc / 右クリックでキャンセル
            </TextBlock>
        </Border>
    </Canvas>
</Window>
